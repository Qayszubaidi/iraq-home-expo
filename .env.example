# Server-side SMTP settings — never expose these values to the browser or commit real secrets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=website@iraqhomeexpo.com
SMTP_PASS=replace-with-secret
SMTP_FROM="Iraq Home Expo <website@iraqhomeexpo.com>"
# Comma-separated recipients are supported.
CONTACT_TO=info@iraqhomeexpo.com,qayszubaidi@gmail.com
SALES_TO=sales@iraqhomeexpo.com,qayszubaidi@gmail.com

# Recommended anti-bot protection for production (Cloudflare Turnstile).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose; TURNSTILE_SECRET_KEY must remain server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional canonical production origin used for same-origin form checks.
NEXT_PUBLIC_SITE_URL=https://iraqhomeexpo.com

# Iraq Home Expo Admin CMS (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used only to read private form recipient settings; never expose this in NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
